# Admin page (/adminpage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=random-32-char-secret-for-cookie-signing

# Technocore (optional override)
TECHNOCORE_BASE_URL=https://technocore.chat

# Production: load identities from env (recommended)
# TECHNOCORE_IDENTITIES=[{"id":"primary","label":"Primary Node","did":"did:key:z6Mk...","private_key_hex":"..."}]

# Local dev: auto-loads ../node_identity.json and ../node_identity_02.json when TECHNOCORE_IDENTITIES is unset
